{
  // 게시 워크플로 깨우기 전용 Worker — tick/index.js 머리 주석. 배포: npx wrangler deploy -c tick/wrangler.jsonc
  "name": "lumiya-poster-tick",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  // GitHub schedule 과 같은 창: JST 07:00~22:59(UTC 22·23시, 0~13시) 20분마다
  "triggers": { "crons": ["*/20 22,23,0-13 * * *"] },
  "observability": { "enabled": true }
}
